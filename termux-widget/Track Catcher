#!/data/data/com.termux/files/usr/bin/bash
# Ярлик Termux:Widget «Track Catcher»: оновити меню з GitHub → відкрити меню.
# Ставиться в ~/.shortcuts автоматично (menu.sh, пункт 9) — як «Dorama.land DEV».
set -u

PROJECT="$HOME/faric-track-catcher"
SYNC="$PROJECT/tools/termux/tc-sync.sh"
MENU="$PROJECT/menu.sh"

if [ ! -f "$MENU" ]; then
    echo
    echo "Меню Track Catcher не знайдено:"
    echo "$MENU"
    echo
    read -r -p "Enter..."
    exit 1
fi

cd "$PROJECT" || exit 1

if [ -f "$SYNC" ]; then
    bash "$SYNC" --quiet
    sync_rc=$?
    # 0 — оновлено, 10 — уже актуально; інше — показати й відкрити наявне меню
    if [ "$sync_rc" -ne 0 ] && [ "$sync_rc" -ne 10 ]; then
        echo
        echo "⚠️ Автооновлення не завершено (код $sync_rc)."
        echo "Відкриваю наявну локальну версію меню."
        sleep 2
    fi
fi

export TC_MENU_SYNCED=1
exec bash "$MENU"
