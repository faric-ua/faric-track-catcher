<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Запис звуку, який грає телефон (AudioPlaybackCapture вимагає цей дозвіл). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Після «Стоп» — лише дозбереження останніх пісень. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Оновлення з Google Диска автора (як Dorama T88): читати файл версії й APK. Записи нікуди не йдуть. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Відкрити вікно Android «Оновити» для перевіреного APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Щоб показати назву плеєра («Джерело») — плеєри мають значок у меню застосунків. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".TrackCatcherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Track Catcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackCatcher">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Інструкція: поворот не перезавантажує сторінку (лишаєшся в тому самому розділі). -->
        <activity
            android:name=".ui.GuideActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Інструкція"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Перевірений APK оновлення (cache/updates/) — вікну встановлення Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|dataSync" />

        <service
            android:name=".capture.NowPlayingListener"
            android:exported="true"
            android:label="Track Catcher — назви пісень"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
